{
  "name": "dsh-purge",
  "version": "0.1.1-rc.1-0.2",
  "description": "dsh 指令权威性清洗插件：25 patch + 启动自动重洗 + /purge 命令 + 模型工具。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "files": [
    "lib",
    "bin",
    "docs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "purge",
    "jailbreak",
    "instructions",
    "prompt-injection",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuJunZhiXue/dsh-purge.git"
  },
  "homepage": "https://github.com/YuJunZhiXue/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/YuJunZhiXue/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
